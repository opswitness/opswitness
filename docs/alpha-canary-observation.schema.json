{
  "$id": "https://opswitness.com/schemas/alpha-canary-observation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "checks": {
      "additionalProperties": false,
      "properties": {
        "cadence": {
          "$ref": "#/$defs/cadence"
        },
        "clean_install": {
          "$ref": "#/$defs/cleanInstall"
        },
        "first_work": {
          "$ref": "#/$defs/firstWork"
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        },
        "soak": {
          "$ref": "#/$defs/soak"
        }
      },
      "required": [
        "soak",
        "cadence",
        "recovery",
        "clean_install",
        "first_work"
      ],
      "type": "object"
    },
    "evidence_type": {
      "const": "opswitness-alpha-canary-observation"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "evidence_type",
    "candidate",
    "run",
    "checks"
  ],
  "title": "OpsWitness Alpha canary observation",
  "type": "object",
  "$defs": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "dmg_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "git_commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tag": {
          "const": "v0.1.0-alpha.1"
        },
        "workflow_run_attempt": {
          "$ref": "#/$defs/positiveInteger"
        },
        "workflow_run_id": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "required": [
        "workflow_run_id",
        "workflow_run_attempt",
        "git_commit",
        "tag",
        "dmg_sha256",
        "manifest_sha256"
      ],
      "type": "object"
    },
    "cadence": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "opswitness-soak-ledger"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "event_stream_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "expected_interval_seconds": {
              "$ref": "#/$defs/positiveInteger"
            },
            "failed_runs": {
              "const": 0
            },
            "first_success_at": {
              "$ref": "#/$defs/timestamp"
            },
            "grace_seconds": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "last_success_at": {
              "$ref": "#/$defs/timestamp"
            },
            "max_gap_seconds": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "successful_runs": {
              "minimum": 2,
              "type": "integer"
            }
          },
          "required": [
            "expected_interval_seconds",
            "grace_seconds",
            "successful_runs",
            "failed_runs",
            "first_success_at",
            "last_success_at",
            "max_gap_seconds",
            "event_stream_sha256"
          ],
          "type": "object"
        },
        "format": {
          "$ref": "#/$defs/sourceFormat"
        },
        "source_file": {
          "const": "sources/cadence-summary.json"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "authority",
        "format",
        "source_file",
        "source_sha256",
        "captured_at",
        "status",
        "details"
      ],
      "type": "object"
    },
    "cleanInstall": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "opswitness-mounted-dmg-smoke"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "arm64"
            },
            "clean_home": {
              "const": true
            },
            "dmg_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "gatekeeper_assessment": {
              "const": "accepted"
            },
            "loopback_only": {
              "const": true
            },
            "manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "notary_ticket_verified": {
              "const": true
            },
            "os_version": {
              "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$",
              "type": "string"
            },
            "preinstalled_runtimes": {
              "maxItems": 0,
              "type": "array"
            },
            "runtime_chain": {
              "const": [
                "embedded-postgres",
                "paperclip",
                "aioncore",
                "opswitness-backend"
              ]
            }
          },
          "required": [
            "os_version",
            "architecture",
            "dmg_sha256",
            "manifest_sha256",
            "clean_home",
            "preinstalled_runtimes",
            "gatekeeper_assessment",
            "notary_ticket_verified",
            "loopback_only",
            "runtime_chain"
          ],
          "type": "object"
        },
        "format": {
          "$ref": "#/$defs/sourceFormat"
        },
        "source_file": {
          "const": "sources/clean-install-summary.json"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "authority",
        "format",
        "source_file",
        "source_sha256",
        "captured_at",
        "status",
        "details"
      ],
      "type": "object"
    },
    "firstWork": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "opswitness-first-work-evidence"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "artifact_digest_match": {
              "const": true
            },
            "business_result_claimed": {
              "const": false
            },
            "cas_reverified": {
              "const": true
            },
            "codex_login_completed": {
              "const": true
            },
            "dmg_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "explicit_write_approvals": {
              "$ref": "#/$defs/positiveInteger"
            },
            "external_side_effects": {
              "const": false
            },
            "first_work_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "ledger_tail_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "run_id": {
              "$ref": "#/$defs/identifier"
            },
            "user_files_read": {
              "const": false
            },
            "verification_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "verified_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "work_id": {
              "$ref": "#/$defs/identifier"
            },
            "workspace_was_blank": {
              "const": true
            }
          },
          "required": [
            "work_id",
            "run_id",
            "dmg_sha256",
            "manifest_sha256",
            "codex_login_completed",
            "workspace_was_blank",
            "user_files_read",
            "external_side_effects",
            "explicit_write_approvals",
            "first_work_artifact_sha256",
            "verification_artifact_sha256",
            "verified_artifact_sha256",
            "cas_reverified",
            "artifact_digest_match",
            "business_result_claimed",
            "ledger_tail_sha256"
          ],
          "type": "object"
        },
        "format": {
          "$ref": "#/$defs/sourceFormat"
        },
        "source_file": {
          "const": "sources/first-work-summary.json"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "authority",
        "format",
        "source_file",
        "source_sha256",
        "captured_at",
        "status",
        "details"
      ],
      "type": "object"
    },
    "identifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "nonnegativeInteger": {
      "minimum": 0,
      "type": "integer"
    },
    "positiveInteger": {
      "minimum": 1,
      "type": "integer"
    },
    "recovery": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "opswitness-desktop-recovery-smoke"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "artifact_reverified": {
              "const": true
            },
            "duplicate_dispatch_count": {
              "const": 0
            },
            "instance_id": {
              "$ref": "#/$defs/identifier"
            },
            "ledger_reconciled": {
              "const": true
            },
            "original_run_id": {
              "$ref": "#/$defs/identifier"
            },
            "recovered_run_id": {
              "$ref": "#/$defs/identifier"
            },
            "recovery_event_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "scenario": {
              "const": "active-work-crash-restart-reconcile"
            },
            "unknown_process_stop_count": {
              "const": 0
            }
          },
          "required": [
            "scenario",
            "original_run_id",
            "recovered_run_id",
            "instance_id",
            "duplicate_dispatch_count",
            "unknown_process_stop_count",
            "ledger_reconciled",
            "artifact_reverified",
            "recovery_event_sha256"
          ],
          "type": "object"
        },
        "format": {
          "$ref": "#/$defs/sourceFormat"
        },
        "source_file": {
          "const": "sources/recovery-summary.json"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "authority",
        "format",
        "source_file",
        "source_sha256",
        "captured_at",
        "status",
        "details"
      ],
      "type": "object"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "host_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_workflow_run_attempt": {
          "$ref": "#/$defs/positiveInteger"
        },
        "producer_workflow_run_id": {
          "$ref": "#/$defs/positiveInteger"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "id",
        "producer_workflow_run_id",
        "producer_workflow_run_attempt",
        "started_at",
        "completed_at",
        "host_identity_sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "soak": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "opswitness-soak-status"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "blocker_codes": {
              "maxItems": 0,
              "type": "array"
            },
            "continuous": {
              "const": true
            },
            "contract_id": {
              "$ref": "#/$defs/identifier"
            },
            "ledger_tail_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "maximum_duration_seconds": {
              "const": 172800
            },
            "minimum_duration_seconds": {
              "const": 86400
            },
            "observed_duration_seconds": {
              "maximum": 172800,
              "minimum": 86400,
              "type": "integer"
            },
            "state": {
              "const": "passed"
            }
          },
          "required": [
            "contract_id",
            "state",
            "minimum_duration_seconds",
            "maximum_duration_seconds",
            "observed_duration_seconds",
            "continuous",
            "blocker_codes",
            "ledger_tail_sha256"
          ],
          "type": "object"
        },
        "format": {
          "$ref": "#/$defs/sourceFormat"
        },
        "source_file": {
          "const": "sources/soak-status.json"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "authority",
        "format",
        "source_file",
        "source_sha256",
        "captured_at",
        "status",
        "details"
      ],
      "type": "object"
    },
    "sourceFormat": {
      "enum": [
        "json",
        "log_summary"
      ],
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  }
}
