<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.quarterdeck.console</string>
  <key>ProgramArguments</key>
  <array>
    <string>__QD_BIN__</string>
    <string>service</string>
    <string>exec</string>
    <string>console</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>QD_CONFIG_DIR</key>
    <string>__QD_CONFIG_DIR__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__QD_LOG_DIR__/console.out.log</string>
  <key>StandardErrorPath</key>
  <string>__QD_LOG_DIR__/console.err.log</string>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
