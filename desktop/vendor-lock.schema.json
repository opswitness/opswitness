{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opswitness.com/schemas/vendor-lock-v1.json",
  "title": "OpsWitness macOS vendor lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "target": { "const": "aarch64-apple-darwin" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "source_url",
          "upstream_sha256",
          "license",
          "redistribution_review",
          "entrypoints",
          "provision"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "version": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "upstream_sha256": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "build_source_commit": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              { "type": "null" }
            ]
          },
          "build_artifact_sha256": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "license": { "type": "string", "minLength": 1 },
          "notice": { "type": "string" },
          "redistribution_review": {
            "enum": ["approved", "blocked"]
          },
          "entrypoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/+@-]+$"
            }
          },
          "required_prefixes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/+@-]+/$"
            }
          },
          "provision": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "archive_type",
                  "root_path",
                  "output_kind",
                  "entrypoint",
                  "required_paths"
                ],
                "properties": {
                  "archive_type": { "enum": ["tar.gz", "raw"] },
                  "root_path": {
                    "type": "string",
                    "pattern": "^(\\.|(?!/)(?!.*\\.\\.)[A-Za-z0-9._/+@-]+)$"
                  },
                  "output_kind": { "enum": ["executable", "directory"] },
                  "entrypoint": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/+@-]+$"
                  },
                  "required_paths": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/+@-]+$"
                    }
                  }
                }
              }
            ]
          },
          "python_bundle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runtime_version",
              "runtime_source_url",
              "runtime_sha256",
              "runtime_license",
              "runtime_notice",
              "runtime_redistribution_review",
              "dependency_lock_path",
              "dependency_lock_sha256",
              "dependency_license_review_path",
              "dependency_license_review_sha256",
              "dependency_license_review"
            ],
            "properties": {
              "runtime_version": { "type": "string", "pattern": "^3\\.12\\.[0-9]+$" },
              "runtime_source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "runtime_sha256": {
                "oneOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "runtime_license": { "type": "string", "minLength": 1 },
              "runtime_notice": { "type": "string", "minLength": 1 },
              "runtime_redistribution_review": {
                "enum": ["approved", "blocked"]
              },
              "dependency_lock_path": {
                "type": "string",
                "pattern": "^desktop/(?!.*\\.\\.)[A-Za-z0-9._/+@-]+$"
              },
              "dependency_lock_sha256": {
                "oneOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "dependency_license_review_path": {
                "type": "string",
                "pattern": "^desktop/(?!.*\\.\\.)[A-Za-z0-9._/+@-]+$"
              },
              "dependency_license_review_sha256": {
                "oneOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "dependency_license_review": {
                "enum": ["approved", "blocked"]
              }
            }
          }
        }
      }
    }
  }
}
